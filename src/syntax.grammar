@top Document { value }

@skip { space | LineComment }

@detectDelim

value {
  Object |
  Array |
  RawString |
  String |
  Number |
  True |
  False |
  Null
}

String { '"' (stringContent | Escape)* '"' }

Object { "{" (Property ","?)* "}" }

Array { "[" (value ","?)* "]" }

Property { PropertyName ":" value }

PropertyName { Identifier | String }

True { @extend<Identifier, "true"> }
False { @extend<Identifier, "false"> }
Null { @extend<Identifier, "null"> }

@external tokens stringTokenizer from "./tokens" { stringContent, Escape }

@tokens {
  space { $[ \t\n\r]+ }

  LineComment { "#" ![\n\r]* }

  @precedence { RawString, Number, Identifier }

  RawString { '"""' (![\"] | '"' ![\"] | '""' ![\"])* '"""' }

  Number { "-"? ("0" | $[1-9] $[0-9]*) ("." $[0-9]+)? ($[eE] $[+\-]? $[0-9]+)? }

  Identifier { $[A-Za-z0-9_\-]+ }

  "{" "}" "[" "]" ":" ","
}
